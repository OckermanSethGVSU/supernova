# Pinned software versions for reproducible paper benchmarks.
# Shared by all engines; used by build.sh and check.py.
# Changing these pins requires rebuilding the environment and rerunning experiments.

STACK_NAME=paper-cu132-faiss116
STACK_FROZEN_ON=2026-11-14

# --- Platform -------------------------------------------------------------
INSTANCE_TYPE=g5.8xlarge
GPU_NAME="NVIDIA A10G"
NVIDIA_DRIVER=580.159.04
PYTHON_VERSION=3.12

# --- CUDA / PyTorch -------------------------------------------------------
CUDA_VERSION=13.2
TORCH_VERSION=2.15.0+cu132
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu132

# All engines use PyTorch's pip CUDA libraries.
# Conda's CUDA libraries are installed as dependencies but must not be loaded.
CUBLAS_VERSION=13.4.1.3
CUSPARSE_VERSION=12.7.10.12
CUSOLVER_VERSION=12.2.0.11
CUFFT_VERSION=12.2.0.57
CURAND_VERSION=10.4.2.66
CUDART_VERSION=13.2.86
NVRTC_VERSION=13.2.86
NVJITLINK_VERSION=13.2.86

# --- Engines --------------------------------------------------------------

# Official FAISS GPU build, without cuVS integration.
FAISS_VERSION=1.16.0
FAISS_CONDA_SPEC="pytorch::faiss-gpu=1.16.0=py3.12_hc84be16_0_cuda13.2"
FAISS_GIT_TAG=v1.16.0

# One patched cuVS build shared across all cuVS benchmarks.
CUVS_VERSION=26.10.00
CUVS_GIT_TAG=v26.10.00
CUVS_PATCHES="0001-sparse-knn-ip-merge-and-short-batch.diff 0002-cutile-opt-out.diff"
CUVS_PATCH_SHA256="0001-sparse-knn-ip-merge-and-short-batch.diff=077cdf9abd5e48795579930154f99951267b0f4e5bc0f76a112fe7e66e4f2900 0002-cutile-opt-out.diff=9b23fc6b917520a9829a5b3d0eed20731267144ebf8814b67eb1608ea1a81ca7"
RAPIDS_VERSION=26.10

# SPARe and PyLate, pinned to specific commits.
SPARE_PIP="spare @ git+https://github.com/ieeta-pt/SPARe.git@e7f4ad1"
SPARE_COMMIT=e7f4ad1

PYLATE_PIP="pylate @ git+https://github.com/lightonai/pylate.git@3389837"
PYLATE_COMMIT=3389837
PYLATE_VERSION=1.6.0

# nova-bf and harness code are tracked separately by each run's code hash.
# Their revisions may change without changing the pinned library stack.

# --- Shared Python packages ----------------------------------------------
PYARROW_VERSION=26.0.1
NUMPY_VERSION=2.5.4
DUCKDB_VERSION=1.5.3