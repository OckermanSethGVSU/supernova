+// Larger generated cases. k = 40 runs knn_merge_parts' main warp-strided loop (2k >= 32), which
+// the k <= 3 cases above never reach, through several merges, with a short last index batch
+// and uneven query batches. Data: a fixed 64-bit LCG -> integers in [-500, 500] \ {0}, every
+// row dense. Every score is an exact float32 integer (|score| < 2^24) and, for seed 3, no query
+// has a tie at or above its (k+1)-th place (checked offline), so the expected order is unique.
+static SparseKNNInputs<int, float> make_lcg_case(int n_rows,
+                                                 int n_cols,
+                                                 int k,
+                                                 int batch_size_index,
+                                                 int batch_size_query,
+                                                 cuvs::distance::DistanceType metric,
+                                                 uint64_t seed)
+{
+  std::vector<double> x(static_cast<size_t>(n_rows) * n_cols);
+  uint64_t state = seed;
+  for (auto& v : x) {
+    state = state * 6364136223846793005ULL + 1442695040888963407ULL;
+    int r = static_cast<int>((state >> 33) % 1000);
+    v     = r < 500 ? r - 500 : r - 499;
+  }
+
+  SparseKNNInputs<int, float> in;
+  in.n_cols = n_cols;
+  for (int i = 0; i <= n_rows; i++) {
+    in.indptr_h.push_back(i * n_cols);
+  }
+  for (size_t i = 0; i < x.size(); i++) {
+    in.indices_h.push_back(static_cast<int>(i % n_cols));
+    in.data_h.push_back(static_cast<float>(x[i]));
+  }
+
+  bool const ip = metric == cuvs::distance::DistanceType::InnerProduct;
+  std::vector<double> sq(n_rows, 0.0);
+  for (int i = 0; i < n_rows; i++) {
+    for (int j = 0; j < n_cols; j++) {
+      sq[i] += x[i * n_cols + j] * x[i * n_cols + j];
+    }
+  }
+  std::vector<double> score(n_rows);
+  std::vector<int> order(n_rows);
+  for (int q = 0; q < n_rows; q++) {
+    for (int r = 0; r < n_rows; r++) {
+      double dot = 0.0;
+      for (int j = 0; j < n_cols; j++) {
+        dot += x[q * n_cols + j] * x[r * n_cols + j];
+      }
+      score[r] = ip ? dot : sq[q] + sq[r] - 2.0 * dot;  // InnerProduct / L2Expanded
+    }
+    std::iota(order.begin(), order.end(), 0);
+    std::stable_sort(order.begin(), order.end(), [&](int a, int b) {
+      return ip ? score[a] > score[b] : score[a] < score[b];
+    });
+    for (int i = 0; i < k; i++) {
+      in.out_dists_ref_h.push_back(static_cast<float>(score[order[i]]));
+      in.out_indices_ref_h.push_back(order[i]);
+    }
+  }
+  in.k                = k;
+  in.batch_size_index = batch_size_index;
+  in.batch_size_query = batch_size_query;
+  in.metric           = metric;
+  return in;
+}
